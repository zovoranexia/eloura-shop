# /etc/caddy/Caddyfile  - HTTPS reverse proxy for Eloura Chic (Caddy obtains and renews the Let's Encrypt certificate by itself).
# Replace shop.example.com with your domain (its DNS A/AAAA record must already point to this VPS; ports 80 and 443 must be open).

shop.example.com {
	encode zstd gzip

	# Uploads are limited to 5 MB by the app; leave headroom for the multipart envelope.
	request_body {
		max_size 7MB
	}

	reverse_proxy 127.0.0.1:3000 {
		# Caddy sets X-Forwarded-For / -Proto / -Host. The app (TRUST_PROXY=1) uses the first address for rate limits and audit logs.
		header_up X-Real-IP {remote_host}
	}

	header {
		# The app already sends CSP / X-Frame-Options / HSTS (when APP_URL is https); these two are harmless extras.
		-Server
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Access log goes to the systemd journal (read it with: sudo journalctl -u caddy -f). No log file means no file-permission
	# problems: `caddy validate` run as root would otherwise create a root-owned file that the "caddy" service user cannot open.
	log
}

# Optional: send www.* to the main domain. Remove the leading "# " ONLY if a DNS record for www.shop.example.com exists;
# without it Caddy keeps failing to obtain a certificate for that name (noisy logs, Let's Encrypt rate limits).
# www.shop.example.com {
# 	redir https://shop.example.com{uri} permanent
# }
