# =====================================================================================================================
# Eloura Chic - environment. Copy to `.env` (never commit the real file).
#   Docker:        docker compose up -d --build         (reads this file automatically)
#   Local dev:     point DATABASE_URL at a Postgres you run yourself, then `npm run dev`
# =====================================================================================================================

# ---- Database (docker compose builds DATABASE_URL from these) ----
POSTGRES_USER=eloura
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=eloura

# Local development only (not used by docker compose):
# DATABASE_URL="postgresql://eloura:change-me@127.0.0.1:5432/eloura?schema=public"

# ---- Application ----
NODE_ENV=production
# Public URL of the shop. https:// turns on Secure cookies + HSTS.
APP_URL=https://shop.example.com
# Random secret for JWT sessions: openssl rand -base64 48   (>= 32 chars, the server refuses to start in production otherwise)
AUTH_SECRET=
# 1 when behind nginx/Caddy/Cloudflare that sets X-Forwarded-For (needed for correct per-IP rate limits / audit IPs)
TRUST_PROXY=1
# Host port bound on 127.0.0.1 (reverse proxy forwards to it)
APP_PORT=3000
# Where uploads live (a docker volume in compose). Payment proofs are stored privately under <UPLOAD_DIR>/private.
UPLOAD_DIR=./.uploads
TZ=Asia/Dili

# ---- First Super Admin (created on first start when missing) ----
# Quote values that contain '#', e.g. SEED_ADMIN_PASSWORD="Str0ng#Pass-2026" (an unquoted '#' starts a comment).
# In production a strong password (>= 12 chars) is REQUIRED; the seed refuses the development default.
SEED_ADMIN_EMAIL=admin@eloura.local
SEED_ADMIN_NAME=Eloura Admin
SEED_ADMIN_PASSWORD=
# 1 = seed reference data on every start (idempotent: only creates what is missing). 0 = skip.
RUN_SEED=1
# 1 = create the 6 sample categories / 8 sample products / hero banners / WELCOME10 coupon if missing. Use 0 for a clean production catalogue.
SEED_CATALOG=1

# ---- Development only (ignored when NODE_ENV=production) ----
# SEED_DEMO_STAFF=1   -> one demo account per role (manager@, finance@, fulfilment@, support@, customer@eloura.local)
# SEED_DEMO_PASSWORD="Demo#Eloura2026"

# ---- E-mail notifications (optional). Without SMTP_HOST, mails are printed to the server log. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Eloura Chic <no-reply@eloura.example>"

# ---- Legacy hosts (Ubuntu 16.04 / Docker < 20.10.10 / old libseccomp) ----
# Alpine 3.14+ and Debian bookworm images can fail with "operation not permitted". Use bullseye-based images instead:
# NODE_IMAGE=node:20-bullseye-slim
# POSTGRES_IMAGE=postgres:15-bullseye
